# Copy to .env and set your API URL. Restart Expo after changing.
# - Emulator: http://10.0.2.2:3000
# - Physical device (same WiFi): http://YOUR_PC_IP:3000  (ipconfig)
# - Different network: https://xxxx.ngrok-free.app (from "ngrok http 3000")
# Use your backend URL. Examples:
# - Emulator: http://10.0.2.2:3000
# - Physical device (same WiFi): http://YOUR_PC_IP:3000
# - Production: https://your-backend.up.railway.app
EXPO_PUBLIC_API_URL=http://localhost:3000
